{
  "name": "jtg-cloud",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted encrypted cloud storage for Node.js and PM2",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "setup": "node --env-file-if-exists=.env src/cli.mjs setup",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "license": "MIT"
}
