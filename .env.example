# Node.js 24+; the Linux installer configures these values.
PORT=6696
HOST=127.0.0.1
NODE_ENV=development
APP_URL=http://localhost:6696
# Keep false unless behind a trusted reverse proxy on loopback.
TRUST_PROXY=false
# Production requires HTTPS. HTTP is suitable only for local development.
COOKIE_SECURE=false
DATA_DIR=./data
BACKUP_DIR=./backups
# Optional: restrict self-registration to an email domain (example.com).
REGISTRATION_DOMAIN=
